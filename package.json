{
  "name": "firstlight",
  "version": "0.0.0",
  "description": "Run lint, typecheck, and tests in parallel for a coding agent, and return at the first failure.",
  "keywords": [
    "parallel",
    "checks",
    "lint",
    "typecheck",
    "test-runner",
    "npm-run-all",
    "coding-agents"
  ],
  "license": "MIT",
  "author": "meganemura",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meganemura/firstlight.git"
  },
  "homepage": "https://github.com/meganemura/firstlight#readme",
  "bugs": {
    "url": "https://github.com/meganemura/firstlight/issues"
  },
  "type": "module",
  "bin": {
    "firstlight": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "archstrict": "archstrict check",
    "mutation": "stryker run",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@hegeldev/hegel": "0.4.5",
    "@meganemura/depug": "0.1.3",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "26.5.1",
    "archstrict": "0.1.0",
    "stryker-agent-reporter": "0.1.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
